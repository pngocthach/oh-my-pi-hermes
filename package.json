{
	"name": "oh-my-pi-hermes",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/bun": "^1.3.14"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"check-types": "bun run --filter '*' check-types",
		"dev:server": "bun run --filter server dev",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@oh-my-pi-hermes/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@oh-my-pi-hermes/config": "workspace:*",
		"@types/bun": "catalog:",
		"typescript": "catalog:",
		"@biomejs/biome": "^2.5.6"
	},
	"packageManager": "bun@1.3.14"
}
