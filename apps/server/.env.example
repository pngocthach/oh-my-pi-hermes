CORS_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
GATEWAY_API_KEY=replace-me
GATEWAY_MODEL_ID=omp
GATEWAY_DATA_DIR=../../var

OMP_BIN=omp
OMP_PREFIX_ARGS_JSON=[]
# OMP_CWD=/workspace

MAX_WORKERS=8
WORKER_IDLE_MS=900000
WORKER_START_TIMEOUT_MS=10000
WORKER_COMMAND_TIMEOUT_MS=30000
WORKER_SHUTDOWN_TIMEOUT_MS=5000

# Leave empty to disable Discord.
DISCORD_TOKEN=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_IGNORED_CHANNEL_IDS=
DISCORD_FREE_RESPONSE_CHANNEL_IDS=
DISCORD_ENABLE_DMS=false
DISCORD_REQUIRE_MENTION=true
DISCORD_AUTO_THREAD=true
